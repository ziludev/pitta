{
  "_comment": "复制成 mcp.json 后按需改；工具名会变成 mcp__<server>__<tool>",
  "servers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/Users/example/learn/pitta/workspace"]
    },
    "example-http": {
      "url": "https://example.com/mcp",
      "headers": { "Authorization": "Bearer ${TOKEN}" }
    }
  }
}
