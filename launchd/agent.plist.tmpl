<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rendered by `scripts/agentctl install` into ~/Library/LaunchAgents/.
  Placeholders: __LABEL__ __PROJECT__ __NODE__ __HOME__
  Do not edit the installed copy: change this template and reinstall.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT__/src/main.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>

  <!-- A durable harness should outlive crashes, not just be restarted by hand. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>RunAtLoad</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__PROJECT__/logs/agent.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/logs/agent.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd has a minimal PATH; keep the one the shell uses so bash tools find things. -->
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>
</dict>
</plist>
