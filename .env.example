# ---- Feishu app (自建应用, 事件订阅选「长连接」) ----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 允许对话的群/单聊 chat_id, 逗号分隔; 留空 = 不限制 (强烈建议填写)
FEISHU_ALLOWED_CHAT_IDS=
# 允许的发送者 open_id, 逗号分隔; 留空 = 不限制（也用来判定「谁是主人」）
# 只卡单聊和下面 .env 里列的群；群里发 /allow 视为把整个群开放，不再按人卡
FEISHU_ALLOWED_SENDER_IDS=
# 群里 @机器人 才响应
FEISHU_MENTIONS_ONLY=true
# 回答位置: auto = 群里 @ 过才进话题; always = 都进话题; never = 都留在主时间线
FEISHU_REPLY_IN_THREAD=auto
# 回复里 @ 提问的人
FEISHU_MENTION_SENDER=true
# 一轮超过这么多秒，额外发一条完成消息（飞书对卡片更新不推送通知）; 0 = 关闭
FEISHU_DONE_PING_SECONDS=45

# ---- 模型 ----
# magpie = 本机 127.0.0.1:3425 的 OpenAI 兼容代理; 其他走内置 provider (openai / anthropic / deepseek ...)
AGENT_PROVIDER=magpie
AGENT_MODEL=vendor/deepseek-flash
AGENT_THINKING=high
MAGPIE_BASE_URL=http://127.0.0.1:3425/v1
MAGPIE_API_KEY=magpie
# AGENT_PROVIDER=deepseek 时使用
DEEPSEEK_API_KEY=

# ---- 工作区 ----
# agent 的 bash/read/write 只在这个目录里干活
AGENT_WORKSPACE=./workspace
AGENT_DB=.data/agent.sqlite
# 一轮最多多少步工具调用；到上限会停住（进度不丢，回「继续」接着做）
AGENT_MAX_TURNS=80
# 每个会话一个 git worktree; off = 所有会话共用 workspace
AGENT_WORKTREE=auto
# auto = 工作区不是 git 仓库就初始化一个; off = 不做
AGENT_WORKSPACE_GIT=auto
# 每日花费上限（美元），0 = 不限制；超过后拒绝新请求，次日自动重置
AGENT_DAILY_BUDGET_USD=0

# ---- Skills (Claude Code SKILL.md 目录; 逗号分隔, 顺序即优先级) ----
# 默认 ./.pi/skills,./.agents/skills,~/.pi/agent/skills,~/.agents/skills,~/.claude/skills,./workspace/skills
# （和 pi 自己读的目录一致，再加上 Claude Code 的；项目目录优先，重名先到先得）
AGENT_SKILLS_DIRS=

# ---- MCP 生态 ----
# 外接 MCP servers 的配置文件（见 mcp.json.example）；留空/文件不存在 = 不用
AGENT_MCP_CONFIG=./mcp.json

# ---- 客户端桥（桌面 app 通过它看同一个会话；只有本机能连）----
# 0 = 关掉
AGENT_HTTP_PORT=8787
AGENT_HTTP_HOST=127.0.0.1
# 留空 = 不校验；设了之后客户端请求要带这个 token
AGENT_HTTP_TOKEN=

# ---- 语音（本地 whisper，无 API key）----
# auto = 装了就用；off = 关掉
AGENT_ASR=auto
AGENT_ASR_WHISPER=whisper
AGENT_ASR_FFMPEG=ffmpeg
AGENT_ASR_MODEL=base
AGENT_ASR_LANG=zh
# 显式指定 .pt 路径（默认查 ~/.cache/whisper/<model>.pt）
AGENT_ASR_MODEL_PATH=

# ---- 调试 ----
# debug = 打印每一条入站 ws 帧
FEISHU_LOG_LEVEL=info
# 1 = 跳过单写者锁（调试时可以再起一个进程；会抢同一份 SQLite）
AGENT_ALLOW_CONCURRENT=0
