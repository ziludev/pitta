{
  "name": "pi-durable-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal agent on Pi Durable, reachable from Feishu",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node src/main.ts",
    "ask": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "card": "node src/feishu-selftest.ts",
    "test": "node --test tests/*.test.ts",
    "eval": "node evals/run.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-mcp": "^1.5.2",
    "@earendil-works/pi-schema": "^1.5.2",
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "@types/ws": "^8.18.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "mygo-cli": "^0.6.4",
    "typescript": "^5.9.3"
  },
  "bin": {
    "durable": "./bin/durable"
  }
}
